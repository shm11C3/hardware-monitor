{
  "name": "hardware-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "dev:react-devtools": "vite dev --mode react-devtools",
    "react-devtools": "npx react-devtools",
    "build": "tsc && vite build",
    "check:agent-guidance": "node .github/scripts/check-agent-guidance.mjs",
    "test:agent-guidance": "node .github/scripts/test-agent-guidance.mjs",
    "test:agent-hooks": "node .github/scripts/test-agent-hook.mjs",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf:render": "playwright test --config playwright.perf.config.ts",
    "test:perf:render-memory": "playwright test --config playwright.memory.config.ts",
    "test:e2e:native": "node --experimental-strip-types e2e-native/settings/native-first-run-smoke.ts",
    "typecheck:e2e:native": "tsc -p tsconfig.e2e-native.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "lint": "biome lint && biome check && biome format --write",
    "format": "biome format --write && biome check --write",
    "lint:ci": "biome ci",
    "license-checker": "license-checker --production --json > licenses.json",
    "gen:licenses:linux": "node --experimental-strip-types .github/scripts/generate-licenses.ts linux",
    "gen:licenses:win": "node --experimental-strip-types .github/scripts/generate-licenses.ts windows",
    "gen:licenses:mac": "node --experimental-strip-types .github/scripts/generate-licenses.ts macos",
    "gen:licenses:tmp": "node --experimental-strip-types .github/scripts/generate-licenses.ts tmp"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "license-checker": "^25.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "selenium-webdriver": "^4.45.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "i18next": "^26.4.1",
    "jotai": "^2.20.3",
    "lucide-react": "^1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.13",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  }
}
